# Copy to a path outside git (or export in the process environment).
# Replace every REPLACE_ME. Never commit real values.

# Preferred: shared volumes file under ~/code/mcp/ (one absolute path per line).
# Default when unset: ~/code/mcp/local-files-volumes.conf
# LOCAL_FILES_VOLUMES_FILE=/path/to/REPLACE_ME/code/mcp/local-files-volumes.conf
# LOCAL_FILES_SERVER_ID=local-files

# Legacy single-root fallback (still supported when no volumes file is present).
# LOCAL_FILES_ROOT=/path/to/REPLACE_ME_allowed_root

# Optional display name for MCP/health.
LOCAL_FILES_SERVER_NAME=konnectors-local-files

# HTTP transport (Streamable HTTP). Leave unset/false for stdio-only.
LOCAL_FILES_HTTP=false
LOCAL_FILES_BIND=127.0.0.1
LOCAL_FILES_PORT=8792
LOCAL_FILES_BASE_PATH=/mcp
# none | private-network — public exposure is an explicit operator decision.
LOCAL_FILES_PUBLIC_EXPOSURE=none

# Required when LOCAL_FILES_HTTP=true. Prefer a mode-600 file over inline env.
# LOCAL_FILES_BEARER_TOKEN=REPLACE_ME_bearer_token
LOCAL_FILES_BEARER_TOKEN_FILE=/path/to/REPLACE_ME_bearer_token_file

# Optional size / traversal limits (bytes / counts).
# LOCAL_FILES_MAX_READ_BYTES=25165824
# LOCAL_FILES_MAX_CHUNK_BYTES=8388608
# LOCAL_FILES_MAX_MULTI_READ_BYTES=2097152
# LOCAL_FILES_MAX_MULTI_FILES=50
# LOCAL_FILES_MAX_TREE_DEPTH=20
# LOCAL_FILES_MAX_LIST_LIMIT=1000
# LOCAL_FILES_MAX_SEARCH_LIMIT=1000
